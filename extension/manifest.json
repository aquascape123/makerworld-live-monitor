{
  "manifest_version": 3,
  "name": "MakerWorld Monitor",
  "version": "2.1",
  "description": "Monitor MakerWorld downloads, prints, boosts, and points with ESP32, Telegram, and Home Assistant MQTT.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://www.makeronline.com/en/*",
    "https://api.telegram.org/*",
    "http://*/*",
    "ws://*/*",
    "wss://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://www.makeronline.com/en/user/Uploads/Models.html*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}