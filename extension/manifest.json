{
  "manifest_version": 3,
  "name": "MakerWorld Monitor for ESP32",
  "version": "2.1",
  "description": "Monitor downloads and prints on MakerWorld, sending notifications to ESP32 display.",
  "permissions": [
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://www.makeronline.com/en/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://www.makeronline.com/en/user/Uploads/Models.html*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}